//CODIGO AA1.3
function setup() {
  createCanvas(400, 400);
  noLoop();//dibuja una sola vez y para.
}

function draw() {
  background(155, 25, 80);
  // quitar borde 
  noStroke();
  
  // Franja 1 osea el primer rect.
  fill(20, 35, 100);
  rect(0, 0, 400, 90);
  
  // Franja 2 osea el segundo rect
  fill(25, 55, 130); //es el que pone un azul mas bajo 
  rect(0, 90, 400, 90);
  
  // Franja 3
  fill(30, 90, 160);
  rect(0, 180, 400, 90);

  // Borde  de la estrella
  fill(80, 130, 80);
  ellipse(200, 50, 42, 42); //x,y,ancho,alto
  
  // Centro amarillo
  fill(230, 190, 60);
    ellipse(200, 50, 26, 26);
  
  // Rayos con lineas 
  stroke(20, 140, 180);//color rgb
  strokeWeight(4); //borde
  line(200, 15, 200, 28); // arriba
  line(200, 72, 200, 85); // de abajo
  line(153, 50, 166, 50); // derecha
  line(234, 50, 247, 50); //izquierda
  
  // SOL 
  noStroke();
  fill(245, 190, 60);
  ellipse(200, 215, 150, 150); // sol

  // RAYOS DEL SOL
  stroke(245, 120, 50);
  strokeWeight(5);
  line(200, 135, 200, 115); //rayo N.-5
  line(173, 140, 160, 115); //rayo 4
  line(227, 140, 240, 115); // rayo 6
  line(147, 155, 120, 130); //rayo 3
  line(253, 155, 280, 130);  //rayo 7
  line(127, 180, 90, 165); // rayo 2
  line(273, 180, 310, 165); //rayo 8
  line(115, 210, 75, 205); // 1
  line(285, 210, 325, 205); //9
  // MAR
  noStroke();
  fill(20, 80, 150);
  rect(0, 215, 400, 185);// rec del mar 
  // REFLEJO 
  fill(245, 180, 80);
  ellipse(200, 235, 65, 7);
 
  ellipse(213, 261, 98, 6);
  ellipse(193, 276, 72, 4);
  ellipse(207, 289, 58, 4);
  // OLAS para que no tenga relleno 
  noFill(); // quitar relleno
  stroke(90, 150, 220);
  strokeWeight(3);
  
  // Simulacion olas con ellipses 
  ellipse(53, 240, 60, 18); // ola 1
  ellipse(120, 244, 66, 18); // 2
  ellipse(286, 241, 73, 18); // 3
  ellipse(346, 235, 60, 18); // 4
  
  ellipse(33, 270, 80, 18); // segunda fila de olas 
  ellipse(120, 275, 66, 16); //2
  ellipse(286, 272, 86, 20); //3
  ellipse(366, 265, 73, 18);//4
  
  ellipse(53, 315, 100, 24); // tercela fila de olas 
  ellipse(166, 320, 80, 22);
  fill(80, 130, 80);
  rect(286, 310, 100, 24);
  noFill();
  ellipse(366, 325, 80, 22);
  
  ellipse(40, 365, 86, 22); // cuarta fila 
  ellipse(153, 360, 100, 24);
  ellipse(280, 375, 100, 22);
  ellipse(366, 355, 86, 22);

  // PAJAROS
  stroke(40, 60, 130);//color de los pajaros 
  strokeWeight(3); //borded 
 
  
  // Pájaro izquierda 
  line(133, 205, 147, 197);
  line(147, 197, 161, 205);
  
  line(161, 205, 175, 197);//x1,y1-x2,y2 
  line(175, 197, 189, 205);

  // Pájaro derecha 
  line(211, 198, 225, 190);
  line(225, 190, 239, 198);
  
  line(239, 198, 253, 190);
  line(253, 190, 267, 198);
}
