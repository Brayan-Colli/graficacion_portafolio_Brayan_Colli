function drawOso() {
  ellipse(-15, -15, 15, 15);
  ellipse(15, -15, 15, 15);
  ellipse(0, 0, 40, 40);
  ellipse(0, 10, 20, 15);
  fill(0);
  ellipse(-8, -2, 6.6);
  ellipse(8, -2, 6.6);
  line(-9,7,7,6);
}

proyecto 2.2
let img;
let logo;
let flores = [];
let estado = { texto: true };

window.setup = async () => {
  createCanvas(windowWidth, windowHeight);
  img = await loadImage("calavera.png");
  logo = await loadImage("tec.png");
  for(let i=0; i<25; i++){
    flores.push({
      x0: random(width),
      y0: random(-1000, 0),
      s: random(0.6, 1.3),
      vel: random(0.8, 2.2),
      rot: random(360)
    });
  }
}

window.windowResized = () => {
  resizeCanvas(windowWidth, windowHeight);
}

window.draw = () => {
  background(0);

  push();
  translate(width/2, height/2);
  imageMode(CENTER);
  image(img, 0, 0, width, height);
  pop();

  noStroke();

  //OJOS PARPADEANDO ALINEADOS
  push();
  translate(width*0.400, height*0.558);
    push();
    let b1 = pow(abs(sin(frameCount*0.07)), 80);
    scale(1, 1 - b1*0.98);
    fill(0);
    ellipse(0, 0, 28, 38);
    pop();
  pop();

  push();
  translate(width*0.480, height*0.558);
    push();
    let b2 = pow(abs(sin(frameCount*0.07)), 80);
    scale(1, 1 - b2*0.98);
    fill(0);
    ellipse(0, 0, 28, 38);
    pop();
  pop();

  // FLAMA 1
  push();
  translate(width*0.245, height*0.02);
    push();
    translate(sin(frameCount*3)*1, sin(frameCount*8)*2);
    scale(sin(frameCount*12)*0.12 + 1);
    fill(255, 245, 180);
    ellipse(0, 0, 20, 28);
      push();
      translate(0, 3);
      fill(255, 180, 0);
      ellipse(0, 0, 5, 9);
      pop();
    pop();
  pop();

  // FLAMA 2
  push();
  translate(width*0.807, height*0.02);
    push();
    translate(sin(frameCount*3+10)*1, sin(frameCount*8+10)*2);
    scale(sin(frameCount*12+20)*0.12 + 1);
    fill(255, 245, 180);
    ellipse(0, 0, 20, 38);
      push();
      translate(0, 3);
      fill(255, 180, 0);
      ellipse(0, 0, 5, 9);
      pop();
    pop();
  pop();

  // FLAMA 3
  push();
  translate(width*0.575, height*0.02);
    push();
    translate(sin(frameCount*4)*1.5, sin(frameCount*9)*2.5);
    scale(sin(frameCount*11)*0.15 + 1);
    fill(255, 240, 100);
    ellipse(0, 0, 20, 84);
      push();
      translate(0, 4);
      fill(255, 120, 0);
      ellipse(0, 0, 7, 12);
      pop();
    pop();
  pop();

  // FLAMA 4
  push();
  translate(width*0.640, height*0.550);
    push();
    translate(sin(frameCount*4+20)*1.5, sin(frameCount*9+20)*2.5);
    scale(sin(frameCount*11+20)*0.15 + 1);
    fill(255, 240, 100);
    ellipse(0, 0, 16, 66);
      push();
      translate(0, 4);
      fill(255, 120, 0);
      ellipse(0, 0, 8, 13);
      pop();
    pop();
  pop();

  // FLAMA 5
  push();
  translate(width*0.900, height*0.458);
    push();
    translate(0, sin(frameCount*10+15)*2);
    scale(sin(frameCount*13+15)*0.12 + 1);
    fill(255, 245, 200);
    ellipse(0, 0, 12, 20);
      push();
      fill(255, 150, 0);
      ellipse(0, 0, 9, 60);
      pop();
    pop();
  pop();
  // FLORES CAYENDO
for(let i=0; i<flores.length; i++){
  let f = flores[i];
  let y = (f.y0 + frameCount * f.vel) % (height + 100);
  let x = f.x0 + sin(frameCount*0.02 + i)*30;

  push();
  translate(x, y);
    push();
    rotate(radians(f.rot + frameCount));
    scale(f.s);
      push(); fill(255, 150, 0); ellipse(0, -8, 8, 14); pop();
      push(); fill(255, 180, 0); ellipse(8, 0, 14, 8); pop();
      push(); fill(255, 200, 0); ellipse(0, 8, 8, 14); pop();
      push(); fill(255, 170, 0); ellipse(-8, 0, 14, 8); pop();
      push(); fill(255, 230, 50); ellipse(0, 0, 10, 10); pop();
    pop();
  pop();
}

  // TEXTOS INSTITUCIONALES
  if(estado.texto){
    push();
    imageMode(CORNER);
    image(logo, 0, 0, 70, 70);
    pop();

    push();
    translate(90, 35);
    fill(255);
    textSize(width*0.018);
    text("TecNM - Felipe Carrillo Puerto", -20,-20);
    textSize(width*0.022);
    fill(255, 200, 0);
    textStyle(BOLD);
    text("ING. SISTEMAS COMPUTACIONALES", -1, -5);
    pop();

    push();
    translate(width/2, height-30);
    fill(255);
    textAlign(CENTER);
    textSize(16);
    text("ALTAR DE FINADOS", 0, 0);
    pop();
  }
}
function windowResized() {
  resizeCanvas(windowWidth, windowHeight);
}
