Practica 2.1
function setup() {
  createCanvas(400, 400);
}

function draw() {
  background(150);
  
  push();
  fill(153, 153, 102);
  translate(30, 100);
  rotate(0.1);
  scale(0.7);
  drawOso();
  pop();

  push();
  fill(102, 102, 51);
  translate(80, 100);
  rotate(0.2);
  scale(1);
  drawOso();
  pop();
  
  push();
   fill(153, 102, 51);
  translate(140, 100);
  rotate(0.3);
  scale(1.5);
  drawOso();
  pop();
  
  push();
  fill(102, 51, 0);
  translate(220, 100);
  rotate(0.4);
  scale(2.0);
  drawOso();
  pop();
  
  push();
  fill(204, 204, 153);
  translate(330, 100);
  rotate(0.4);
  scale(2.5);
  drawOso();
  pop();
}

function drawOso() {
  ellipse(-15, -15, 15, 15);
  ellipse(15, -15, 15, 15);
  ellipse(0, 0, 40, 40);
  ellipse(0, 10, 20, 15);
  fill(0);
  ellipse(-8, -2, 6.6);
  ellipse(8, -2, 6.6);
  line(-9,7,7,6);
}
